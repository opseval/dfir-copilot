#!/usr/bin/env python3
"""Fake `fm` CLI for the unit tests (point DFIR_FM_BIN at this file).

Mimics the three subcommands copilot.afm uses. Behaviour is driven by environment variables so
tests need no state files:
  FAKE_FM_MODE     ok (default) | nolicense | nomodel | error | colorerror | exit1 | badjson | empty |
                   badbytes | sleep | echo
  FAKE_FM_GREEDY   stdout for a `respond --greedy` call     (default: FAKE_FM_TEXT or "ok")
  FAKE_FM_SAMPLED  stdout for a non-greedy `respond` call   (default: FAKE_FM_TEXT or "ok")
  FAKE_FM_SLEEP    seconds to sleep in mode=sleep (default 5)
  FAKE_FM_LOG      if set, every argv is appended here as a JSON line (lets tests assert pinning)
"""
import json
import os
import sys
import time

mode = os.environ.get("FAKE_FM_MODE", "ok")
log = os.environ.get("FAKE_FM_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps(sys.argv[1:]) + "\n")
cmd = sys.argv[1] if len(sys.argv) > 1 else ""

if cmd == "license":
    if mode == "nolicense":
        print("Not agreed. Run `fm license` to review and agree to the terms.")
        sys.exit(0)
    print("Agreed to license FM1 version 1.0 on Sep 27, 2026 at 12:39 PM.")
    sys.exit(0)

if cmd == "available":
    if mode == "nomodel":
        print("System model unavailable: Apple Intelligence is not enabled")
        sys.exit(1)
    if mode == "probeerror":
        print("Error: available check failed")
        sys.exit(0)
    print("System model available")
    sys.exit(0)

if cmd == "respond":
    if mode == "sleep":
        time.sleep(float(os.environ.get("FAKE_FM_SLEEP", "5")))
    if mode == "exit1":
        print("fm: something went wrong", file=sys.stderr)
        sys.exit(1)
    if mode == "error":                     # the real fm prints `Error: ...` on failure
        print("Error: An unsupported generation guide was used.")
        sys.exit(0)
    if mode == "colorerror":                # same, but coloured and on stderr
        sys.stderr.write("\x1b[1;31mError:\x1b[0m something failed\n")
        sys.exit(0)
    if mode == "empty":
        sys.exit(0)
    if mode == "badbytes":
        sys.stdout.buffer.write(b"ok \xff\xfe garbage\n")
        sys.exit(0)
    prompt = sys.stdin.read()
    if mode == "echo":
        print(prompt.rstrip("\n"))
        sys.exit(0)
    if mode == "badjson":
        print("this is not json")
        sys.exit(0)
    key = "FAKE_FM_GREEDY" if "--greedy" in sys.argv else "FAKE_FM_SAMPLED"
    print(os.environ.get(key) or os.environ.get("FAKE_FM_TEXT", "ok"))
    sys.exit(0)

print(f"fake fm: unknown command {cmd!r}", file=sys.stderr)
sys.exit(2)
